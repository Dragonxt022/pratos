{
  "name": "pratos-fichas-tecnicas",
  "version": "1.0.0",
  "description": "Aplicacao de ficha tecnica de pratos (MVC, Express 5 + Sequelize)",
  "author": "Taiksu",
  "main": "main.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "electron": "set \"ELECTRON_RUN_AS_NODE=\" & electron .",
    "rebuild": "electron-rebuild -f -w sqlite3",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "tw:build": "tailwindcss -i ./src/tailwind.css -o ./public/stylesheets/tailwind.css",
    "tw:watch": "tailwindcss -i ./src/tailwind.css -o ./public/stylesheets/tailwind.css --watch"
  },
  "build": {
    "appId": "com.pratos.fichas-tecnicas",
    "productName": "Fichas Técnicas",
    "icon": "public/logos/icon-512.png",
    "asar": false,
    "files": [
      "**/*",
      "!.env",
      "!*.sqlite",
      "!src/**",
      "!migrations/**",
      "!seeders/**",
      "!dist-electron/**"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.food-and-drink"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "express-ejs-layouts": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.5",
    "sequelize": "^6.37.5",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.1",
    "sequelize-cli": "^6.6.2",
    "tailwindcss": "^4.3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
