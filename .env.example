# Aplicacao
APP_NAME="Pratos - Fichas Tecnicas"
NODE_ENV=development
PORT=3000

# Banco de dados (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pratos_dev
DB_USER=root
DB_PASS=
DB_DIALECT=mysql

# Markup padrao usado no calculo de preco sugerido
DEFAULT_MARKUP=3.5

# Integracao com o Event Broker (usado pelos arquivos em client/)
EVENT_BROKER_URL=
EVENT_BROKER_SERVICE_TOKEN=
