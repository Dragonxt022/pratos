<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="greet-row">
  <div class="greet-user">
    <div class="greet-avatar"><%= (typeof usuarioNome !== 'undefined' && usuarioNome ? usuarioNome : 'V').charAt(0).toUpperCase() %></div>
    <div class="greet-text">
      <div>Boa tarde,</div>
      <strong><%= typeof usuarioNome !== 'undefined' && usuarioNome ? usuarioNome : 'Visitante' %></strong>
    </div>
  </div>
  <a class="cta-pill" href="/editor">Novo prato</a>
</div>

<% if (!temDados) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    <h3>Nenhum prato cadastrado</h3>
    <p>Importe um CSV em <a href="/fichas">Fichas</a> ou crie um prato no <a href="/editor">Editor</a>.</p>
  </div>
<% } else { %>
  <div class="stat-card">
    <div class="stat-lbl">Valor total em produção</div>
    <div class="stat-val">R$ <%= kpis.valorTotalProducao.toFixed(2).replace('.', ',') %></div>
  </div>

  <div class="quick-actions">
    <a class="qa-item" href="/fichas">
      <span class="qa-circle"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
      <span class="qa-lbl">Fichas</span>
    </a>
    <a class="qa-item" href="/insumos">
      <span class="qa-circle"><svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span>
      <span class="qa-lbl">Insumos</span>
    </a>
    <a class="qa-item" href="/editor">
      <span class="qa-circle"><svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>
      <span class="qa-lbl">Editor</span>
    </a>
    <a class="qa-item" href="/fichas">
      <span class="qa-circle"><svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
      <span class="qa-lbl">Importar</span>
    </a>
    <a class="qa-item" href="/formulas">
      <span class="qa-circle"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
      <span class="qa-lbl">Fórmulas</span>
    </a>
  </div>

  <div class="sec-title">Resumo</div>
  <div class="stat-grid">
    <div class="stat-mini"><div class="stat-lbl">Fichas</div><div class="stat-val"><%= kpis.totalPratos %></div></div>
    <div class="stat-mini"><div class="stat-lbl">Custo médio</div><div class="stat-val">R$ <%= kpis.custoMedio.toFixed(2).replace('.', ',') %></div></div>
    <div class="stat-mini <%= kpis.cmvMedio === null ? '' : kpis.cmvMedio <= 35 ? '' : kpis.cmvMedio <= 50 ? 'warn' : 'bad' %>">
      <div class="stat-lbl">CMV médio</div>
      <div class="stat-val"><%= kpis.cmvMedio !== null ? kpis.cmvMedio.toFixed(1).replace('.', ',') + '%' : '-' %></div>
    </div>
    <div class="stat-mini"><div class="stat-lbl">Margem média</div><div class="stat-val"><%= kpis.margemMedia !== null ? kpis.margemMedia.toFixed(1).replace('.', ',') + '%' : '-' %></div></div>
  </div>

  <% if (tendenciaCusto && tendenciaCusto.labels.length > 1) { %>
    <div class="sec-title">Tendência de custo</div>
    <div class="chart-card wide" style="margin-bottom:16px">
      <div class="chart-title" style="display:flex;align-items:center;justify-content:space-between">
        <span>Custo médio do cardápio (R$)</span>
        <a href="/analise-precos" style="font-size:11px;font-weight:600;color:var(--gn-d);text-decoration:none">Ver progresso por prato →</a>
      </div>
      <div class="chart-wrap"><canvas id="c-tendencia"></canvas></div>
    </div>
  <% } %>

  <div class="sec-title">Analytics</div>
  <div class="charts-grid">
    <div class="chart-card wide"><div class="chart-title">CMV por prato (%)</div><div class="chart-wrap"><canvas id="c-cmv"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Margem de lucro por prato (%)</div><div class="chart-wrap"><canvas id="c-mg"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Custo total por prato (R$)</div><div class="chart-wrap"><canvas id="c-ct"></canvas></div></div>
  </div>

  <script>
    (function () {
      var charts = <%- JSON.stringify(charts) %>;
      var labels = charts.labels.map(function (l) { return l.length > 15 ? l.substring(0, 13) + '..' : l; });
      var GR = '#2bb24a', RD = '#e15046', AM = '#d9900f', BL = '#3179e0', GY = '#cfe2cb';

      function opts() {
        return {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { ticks: { font: { size: 10 }, color: '#60705e' }, grid: { display: false } },
            y: { ticks: { font: { size: 10 }, color: '#60705e' }, grid: { color: '#e2ede0' } },
          },
        };
      }

      new Chart(document.getElementById('c-cmv'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ data: charts.cmv, backgroundColor: charts.cmv.map(function (v) { return v === null ? GY : v <= 35 ? GR : v <= 50 ? AM : RD; }), borderRadius: 5 }] },
        options: opts(),
      });
      new Chart(document.getElementById('c-mg'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ data: charts.margem, backgroundColor: charts.margem.map(function (v) { return v === null ? GY : v >= 0 ? BL : RD; }), borderRadius: 5 }] },
        options: opts(),
      });
      new Chart(document.getElementById('c-ct'), {
        type: 'bar',
        data: { labels: labels, datasets: [{ data: charts.custoTotal, backgroundColor: AM, borderRadius: 5 }] },
        options: opts(),
      });

      var tendencia = <%- JSON.stringify(tendenciaCusto || { labels: [], valores: [] }) %>;
      var elTendencia = document.getElementById('c-tendencia');
      if (elTendencia && tendencia.labels.length) {
        new Chart(elTendencia, {
          type: 'line',
          data: {
            labels: tendencia.labels,
            datasets: [{
              data: tendencia.valores,
              borderColor: GR,
              backgroundColor: 'rgba(43,178,74,.12)',
              fill: true,
              tension: 0.3,
              pointRadius: 2,
              pointBackgroundColor: GR,
            }],
          },
          options: opts(),
        });
      }
    })();
  </script>
<% } %>
