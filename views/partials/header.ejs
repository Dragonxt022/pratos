<div class="topbar-wrap">
  <nav class="topbar">
    <a class="topbar-icon w-10 h-10" href="/" aria-label="Inicio">
      <img
        src="https://login.taiksu.com.br/frontend/img/menu_service.png"
        alt=""
        onerror="this.onerror=null; this.src='/logos/menu_service.png';"
      />
    </a>

    <a class="topbar-logo" href="/">
      <img
        src="https://login.taiksu.com.br/frontend/img/logo.png"
        alt="Taiksu"
        onerror="this.onerror=null; this.src='/logos/logo.png';"
      />
      <sup>Fichas</sup>
    </a>

    <button
      class="topbar-icon"
      type="button"
      onclick="document.getElementById('drawer').classList.add('open');document.getElementById('drawerOverlay').classList.add('open')"
      aria-label="Abrir menu"
    >
      <img
        src="https://vistoria.taiksu.com.br/assets/menu-icon.png"
        alt=""
        onerror="this.onerror=null; this.src='/logos/menu-icon.png';"
      />
    </button>
  </nav>
</div>

<div class="drawer-overlay" id="drawerOverlay" onclick="document.getElementById('drawer').classList.remove('open');this.classList.remove('open')"></div>
<aside class="drawer" id="drawer">
  <div class="drawer-profile">
    <div class="drawer-avatar"><%= (typeof usuarioNome !== 'undefined' && usuarioNome ? usuarioNome : 'V').charAt(0).toUpperCase() %></div>
    <div>
      <div class="drawer-name"><%= typeof usuarioNome !== 'undefined' && usuarioNome ? usuarioNome : 'Visitante' %></div>
      <div class="drawer-sub">Fichas Tecnicas</div>
    </div>
    <button class="drawer-close" type="button" onclick="document.getElementById('drawer').classList.remove('open');document.getElementById('drawerOverlay').classList.remove('open')" aria-label="Fechar menu">
      <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="drawer-nav">
    <a class="drawer-item<%= currentPath === '/' ? ' active' : '' %>" href="/">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    <a class="drawer-item<%= currentPath.startsWith('/fichas') ? ' active' : '' %>" href="/fichas">
      <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      Fichas Tecnicas
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    <a class="drawer-item<%= currentPath.startsWith('/insumos') ? ' active' : '' %>" href="/insumos">
      <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      Insumos
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    <a class="drawer-item<%= currentPath.startsWith('/editor') ? ' active' : '' %>" href="/editor">
      <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Editor de Pratos
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    <a class="drawer-item<%= currentPath.startsWith('/analise-precos') ? ' active' : '' %>" href="/analise-precos">
      <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Progresso de Preços
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    <a class="drawer-item<%= currentPath.startsWith('/api-integracoes') ? ' active' : '' %>" href="/api-integracoes">
      <svg viewBox="0 0 24 24"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/></svg>
      API
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
    <a class="drawer-item<%= currentPath.startsWith('/formulas') ? ' active' : '' %>" href="/formulas">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      Como calculamos
      <svg class="chev" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
  </div>
</aside>
