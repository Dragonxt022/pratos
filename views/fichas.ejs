<% if (mensagem) { %>
  <div class="msg-bar"><%= mensagem %></div>
<% } %>

<!-- Modal importar CSV -->
<div class="modal-overlay" id="importar-csv-overlay">
  <div class="modal-card" style="max-width:380px">
    <div class="modal-icon info">
      <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    </div>
    <div class="modal-title">Importar CSV</div>
    <div class="modal-text">O arquivo deve conter as colunas: <code>CODIGO_PRATO, NOME_PRATO, RENDIMENTO, TIPO_ITEM, CODIGO_ITEM, NOME_ITEM, UNIDADE, QUANTIDADE, CUSTO_TOTAL</code></div>
    <form method="post" action="/fichas/importar" enctype="multipart/form-data" class="modal-form">
      <label class="file-pick" style="margin-bottom:16px">
        <span class="file-btn">Escolher arquivo</span>
        <span class="file-name" id="csv-file-name">Nenhum arquivo selecionado</span>
        <input type="file" name="csv" accept=".csv" required onchange="document.getElementById('csv-file-name').textContent = this.files[0] ? this.files[0].name : 'Nenhum arquivo selecionado'" />
      </label>
      <div class="modal-actions">
        <button class="btn" type="button" onclick="document.getElementById('importar-csv-overlay').classList.remove('open')">Cancelar</button>
        <button class="btn btn-p" type="submit">
          <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Importar
        </button>
      </div>
    </form>
  </div>
</div>

<div class="toolbar">
  <form class="tleft" method="get" action="/fichas" style="margin:0;flex:1">
    <div class="search-pill">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" placeholder="Buscar prato..." value="<%= search %>" />
    </div>
  </form>

  <form class="mup" method="post" action="/config" style="margin:0" id="form-markup">
    <input type="hidden" name="voltar" value="/fichas<%= search ? ('?q=' + encodeURIComponent(search)) : '' %>" />
    <label for="mi">Markup</label>
    <input type="number" name="markup" id="mi" value="<%= configuracao.markup %>" step="0.1" min="1" onchange="this.form.submit()" />
    <span style="font-size:11px;color:var(--txt3)">x</span>
    <div class="tog-group">
      <label class="toggle-pill">
        <input type="checkbox" name="markup_inclui_embalagem" onchange="this.form.submit()" <%= configuracao.markup_inclui_embalagem ? 'checked' : '' %> />
        <span class="toggle-slider"></span>
      </label>
      <label class="lbl">Preco sugerido c/ embalagem</label>
    </div>
    <div class="tog-group">
      <label class="toggle-pill">
        <input type="checkbox" name="cmv_inclui_embalagem" onchange="this.form.submit()" <%= configuracao.cmv_inclui_embalagem ? 'checked' : '' %> />
        <span class="toggle-slider"></span>
      </label>
      <label class="lbl">CMV c/ embalagem</label>
    </div>
  </form>

  <button class="btn btn-p" type="button" onclick="document.getElementById('importar-csv-overlay').classList.add('open')">
    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    Importar CSV
  </button>
</div>

<div>
  <% if (!pratos.length) { %>
    <div class="empty">
      <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <h3>Nenhuma ficha encontrada</h3>
      <p>Importe um CSV ou crie um prato no Editor.</p>
    </div>
  <% } else { %>
    <div class="pratos-grid">
      <% pratos.forEach(function (p) { %>
        <% var c = p.calc; var insumos = p.itens.filter(function (i) { return i.tipo === 'INSUMO'; });
           var embalagens = p.itens.filter(function (i) { return i.tipo === 'EMBALAGEM'; });
           var cmvCls = c.cmv === null ? '' : c.cmv <= 35 ? 'p-ok' : c.cmv <= 50 ? 'p-warn' : 'p-bad';
           var markupLbl = configuracao.markup_inclui_embalagem ? 'Preco sug. (c/emb)' : 'Preco sug. (s/emb)';
           var pesoLbl = c.pesoTotal > 0 ? (c.pesoTotal >= 1000 ? (c.pesoTotal / 1000).toFixed(3).replace('.', ',') + ' kg' : c.pesoTotal + ' g') : '-';
        %>
        <div class="dish-card" data-cod="<%= p.prato.codigo %>">
          <div class="dish-hdr" onclick="this.closest('.dish-card').classList.toggle('open')">
            <div class="thumb thumb-sm">
              <% if (p.prato.imagem_url) { %>
                <img src="<%= p.prato.imagem_url %>" alt="" />
              <% } else { %>
                <svg viewBox="0 0 24 24"><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3zm0 0v7"/><path d="M3 2c0 6 4 6 4 9v9"/></svg>
              <% } %>
            </div>
            <div class="dish-hdr-txt">
              <span class="cod"><%= p.prato.codigo %></span>
              <span class="cname"><%= p.prato.nome %></span>
            </div>
            <svg class="chev" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
          <div class="dish-stats">
            <div class="st"><span class="st-l">Custo insumos</span><span class="st-v red">R$ <%= c.custoInsumos.toFixed(2).replace('.', ',') %></span></div>
            <div class="st"><span class="st-l">Embalagem</span><span class="st-v">R$ <%= c.custoEmbalagem.toFixed(2).replace('.', ',') %></span></div>
            <div class="st"><span class="st-l">Custo total</span><span class="st-v red">R$ <%= c.custoTotal.toFixed(2).replace('.', ',') %></span></div>
            <div class="st"><span class="st-l"><%= markupLbl %></span><span class="st-v green">R$ <%= c.precoSugerido.toFixed(2).replace('.', ',') %></span></div>
            <div class="st">
              <span class="st-l">Preco de venda</span>
              <form class="pv-wrap" method="post" action="/fichas/<%= encodeURIComponent(p.prato.codigo) %>/preco-venda" onclick="event.stopPropagation()">
                <span>R$</span>
                <input class="pv-inp" type="number" step="0.01" min="0" name="preco_venda" value="<%= c.precoVenda || '' %>" onchange="this.form.submit()" />
              </form>
            </div>
            <div class="st"><span class="st-l">CMV <%= configuracao.cmv_inclui_embalagem ? '(c/emb)' : '(s/emb)' %></span>
              <% if (c.cmv !== null) { %><span class="pill <%= cmvCls %>"><%= c.cmv.toFixed(1).replace('.', ',') %> %</span>
              <% } else { %><span style="font-size:10px;color:var(--txt3)">informe preco</span><% } %>
            </div>
            <div class="st"><span class="st-l">Margem lucro</span>
              <% if (c.margem !== null) { %><span class="st-v <%= c.margem >= 0 ? 'green' : 'red' %>"><%= c.margem.toFixed(1).replace('.', ',') %> %</span>
              <% } else { %><span class="st-v muted">-</span><% } %>
            </div>
            <div class="st"><span class="st-l">Peso total</span><span class="st-v"><%= pesoLbl %></span></div>
            <div class="st"><span class="st-l">Rendimento</span><span class="st-v"><%= p.prato.rendimento %> un</span></div>
          </div>
          <div class="dish-body">
            <!-- Upload de imagem clicável -->
            <div style="padding:0 0 14px" onclick="event.stopPropagation()">
              <form method="post" action="/fichas/<%= encodeURIComponent(p.prato.codigo) %>/imagem" enctype="multipart/form-data" id="form-img-<%= p.prato.codigo %>">
                <input type="file" name="imagem" accept="image/*" id="inp-img-<%= p.prato.codigo %>" style="display:none" onchange="this.form.submit()" />
              </form>
              <div class="img-upload-wrap img-clickable" onclick="document.getElementById('inp-img-<%= p.prato.codigo %>').click()">
                <% if (p.prato.imagem_url) { %>
                  <img src="<%= p.prato.imagem_url %>" alt="" />
                  <div class="img-hover-trash">
                    <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                    <span>Trocar foto</span>
                  </div>
                <% } else { %>
                  <div class="img-placeholder">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <span>Clique para adicionar foto</span>
                  </div>
                <% } %>
              </div>
            </div>

            <% if (insumos.length) { %>
              <div class="ing-sec">
                <div class="ing-ttl ins">Insumos</div>
                <table class="itbl">
                  <thead><tr><th>Item</th><th>Codigo</th><th>Qtd</th><th>Custo</th></tr></thead>
                  <tbody>
                    <% insumos.forEach(function (i) { %>
                      <tr><td><%= i.nome %></td><td class="tcod"><%= i.codigo %></td><td class="tqty"><%= i.quantidade %> <%= i.unidade %></td><td>R$ <%= i.custo_total.toFixed(2).replace('.', ',') %></td></tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
            <% if (embalagens.length) { %>
              <div class="ing-sec">
                <div class="ing-ttl emb">Embalagens</div>
                <table class="itbl">
                  <thead><tr><th>Item</th><th>Codigo</th><th>Qtd</th><th>Custo</th></tr></thead>
                  <tbody>
                    <% embalagens.forEach(function (i) { %>
                      <tr><td><%= i.nome %></td><td class="tcod"><%= i.codigo %></td><td class="tqty"><%= i.quantidade %> <%= i.unidade %></td><td>R$ <%= i.custo_total.toFixed(2).replace('.', ',') %></td></tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
