<% var insumosLinhas = itens.filter(function (i) { return i.tipo === 'INSUMO'; });
   var embalagensLinhas = itens.filter(function (i) { return i.tipo === 'EMBALAGEM'; });
   var pesoLbl = calc.pesoTotal > 0 ? (calc.pesoTotal >= 1000 ? (calc.pesoTotal / 1000).toFixed(3).replace('.', ',') + ' kg' : calc.pesoTotal + ' g') : '-';
%>

<!-- Cabeçalho com voltar + ações -->
<div class="ep-hdr" style="border-radius:var(--radius-lg);margin-bottom:14px">
  <a href="/editor" class="btn" style="flex-shrink:0">
    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    Pratos
  </a>
  <h3 style="flex:1;text-align:center"><%= pratoSelecionado.nome %></h3>
  <form method="post" action="/editor/<%= encodeURIComponent(pratoSelecionado.codigo) %>/excluir"
    data-confirm
    data-confirm-title="Excluir prato"
    data-confirm-text="Excluir &quot;<%= pratoSelecionado.nome %>&quot;? Esta acao nao pode ser desfeita."
    data-confirm-label="Excluir">
    <button class="btn btn-danger" type="submit">
      <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      Excluir
    </button>
  </form>
</div>

<!-- Resumo de custos -->
<div class="stat-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:14px">
  <div class="stat-mini"><div class="stat-lbl">Custo insumos</div><div class="stat-val" style="color:var(--rd)">R$ <%= calc.custoInsumos.toFixed(2).replace('.', ',') %></div></div>
  <div class="stat-mini"><div class="stat-lbl">Embalagem</div><div class="stat-val">R$ <%= calc.custoEmbalagem.toFixed(2).replace('.', ',') %></div></div>
  <div class="stat-mini"><div class="stat-lbl">Custo total</div><div class="stat-val" style="color:var(--rd)">R$ <%= calc.custoTotal.toFixed(2).replace('.', ',') %></div></div>
  <div class="stat-mini"><div class="stat-lbl">Peso total</div><div class="stat-val"><%= pesoLbl %></div></div>
  <div class="stat-mini"><div class="stat-lbl">Rendimento</div><div class="stat-val"><%= pratoSelecionado.rendimento %> un</div></div>
  <div class="stat-mini"><div class="stat-lbl">Preco sugerido</div><div class="stat-val">R$ <%= calc.precoSugerido.toFixed(2).replace('.', ',') %></div></div>
</div>

<!-- Foto do prato -->
<div class="ep-section-title">Foto do prato</div>
<form method="post" action="/fichas/<%= encodeURIComponent(pratoSelecionado.codigo) %>/imagem" enctype="multipart/form-data" id="form-img-det">
  <input type="hidden" name="voltar" value="/editor/<%= encodeURIComponent(pratoSelecionado.codigo) %>" />
  <input type="file" name="imagem" accept="image/*" id="inp-img-det" style="display:none" onchange="this.form.submit()" />
</form>
<div class="img-upload-wrap img-clickable" style="margin-bottom:18px" onclick="document.getElementById('inp-img-det').click()">
  <% if (pratoSelecionado.imagem_url) { %>
    <img src="<%= pratoSelecionado.imagem_url %>" alt="" />
    <div class="img-hover-trash">
      <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
      <span>Trocar foto</span>
    </div>
  <% } else { %>
    <div class="img-placeholder">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      <span>Clique para adicionar foto</span>
    </div>
  <% } %>
</div>

<!-- Dados do prato -->
<div class="ep-section-title" style="margin-top:0">Dados do prato</div>
<div class="stat-card" style="padding:16px 18px;margin-bottom:18px">
  <form method="post" action="/editor/<%= encodeURIComponent(pratoSelecionado.codigo) %>">
    <div class="ep-field-row">
      <div class="ep-field"><label>Codigo do prato</label><input value="<%= pratoSelecionado.codigo %>" disabled /></div>
      <div class="ep-field"><label>Nome do prato</label><input name="nome" value="<%= pratoSelecionado.nome %>" required /></div>
    </div>
    <div class="ep-field-row">
      <div class="ep-field"><label>Rendimento (un)</label><input name="rendimento" type="number" min="1" value="<%= pratoSelecionado.rendimento %>" /></div>
      <div class="ep-field"><label>Preco de venda R$</label><input name="preco_venda" type="number" step="0.01" min="0" value="<%= pratoSelecionado.preco_venda || '' %>" /></div>
    </div>
    <button class="btn btn-p" type="submit">Salvar alteracoes</button>
  </form>
</div>

<!-- Insumos -->
<div class="ep-section-title">Insumos <span style="font-weight:400;color:var(--txt3);text-transform:none;letter-spacing:0">· <%= insumosLinhas.length %></span></div>
<div class="list-card" style="margin-bottom:14px">
  <% if (!insumosLinhas.length) { %>
    <div class="ep-empty" style="padding:22px">Nenhum insumo adicionado.</div>
  <% } %>
  <% insumosLinhas.forEach(function (i) { %>
    <div class="list-row">
      <div class="thumb thumb-sm">
        <svg viewBox="0 0 24 24"><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3zm0 0v7"/><path d="M3 2c0 6 4 6 4 9v9"/></svg>
      </div>
      <div class="row-main">
        <div class="row-title"><%= i.nome %></div>
        <div class="row-meta"><%= i.codigo %> · <%= i.quantidade %> <%= i.unidade %></div>
      </div>
      <span class="row-badge">R$ <%= i.custo_total.toFixed(2).replace('.', ',') %></span>
      <form method="post" action="/editor/<%= encodeURIComponent(pratoSelecionado.codigo) %>/itens/<%= i.id %>/excluir"
        data-confirm
        data-confirm-title="Remover insumo"
        data-confirm-text="Remover &quot;<%= i.nome %>&quot; deste prato?"
        data-confirm-label="Remover">
        <button class="row-action" type="submit" title="Remover">
          <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </form>
    </div>
  <% }) %>
</div>

<!-- Embalagens -->
<div class="ep-section-title">Embalagens <span style="font-weight:400;color:var(--txt3);text-transform:none;letter-spacing:0">· <%= embalagensLinhas.length %></span></div>
<div class="list-card" style="margin-bottom:14px">
  <% if (!embalagensLinhas.length) { %>
    <div class="ep-empty" style="padding:22px">Nenhuma embalagem adicionada.</div>
  <% } %>
  <% embalagensLinhas.forEach(function (i) { %>
    <div class="list-row">
      <div class="thumb thumb-sm emb">
        <svg viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
      </div>
      <div class="row-main">
        <div class="row-title"><%= i.nome %></div>
        <div class="row-meta"><%= i.codigo %> · <%= i.quantidade %> <%= i.unidade %></div>
      </div>
      <span class="row-badge">R$ <%= i.custo_total.toFixed(2).replace('.', ',') %></span>
      <form method="post" action="/editor/<%= encodeURIComponent(pratoSelecionado.codigo) %>/itens/<%= i.id %>/excluir"
        data-confirm
        data-confirm-title="Remover embalagem"
        data-confirm-text="Remover &quot;<%= i.nome %>&quot; deste prato?"
        data-confirm-label="Remover">
        <button class="row-action" type="submit" title="Remover">
          <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </form>
    </div>
  <% }) %>
</div>

<!-- Adicionar item -->
<div class="ep-section-title">Adicionar item</div>
<div class="stat-card" style="padding:16px 18px">
  <form method="post" action="/editor/<%= encodeURIComponent(pratoSelecionado.codigo) %>/itens">
    <div class="ep-field">
      <label>Insumo ou embalagem</label>
      <select name="insumo_id" required>
        <option value="">Selecione...</option>
        <% insumos.forEach(function (ins) { %>
          <option value="<%= ins.id %>"><%= ins.codigo %> — <%= ins.nome %> (<%= ins.tipo %>)</option>
        <% }) %>
      </select>
    </div>
    <div class="ep-field-row">
      <div class="ep-field"><label>Quantidade</label><input name="quantidade" type="number" step="0.001" min="0" required /></div>
      <div class="ep-field"><label>Custo total R$</label><input name="custo_total" type="number" step="0.01" min="0" required /></div>
    </div>
    <button class="btn btn-p" type="submit" style="width:100%;justify-content:center">
      <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Adicionar item
    </button>
  </form>
</div>
