<form method="get" action="/insumos" style="margin:0">
  <div class="search-pill">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" name="q" placeholder="Buscar insumo..." value="<%= search %>" onchange="this.form.submit()" />
  </div>
  <input type="hidden" name="tipo" value="<%= tipo %>" />
</form>

<div class="filter-pills">
  <a class="filter-pill<%= !tipo ? ' active' : '' %>" href="/insumos?tipo=<%= search ? '&q=' + encodeURIComponent(search) : '' %>">Todos (<%= contagens.todos %>)</a>
  <a class="filter-pill<%= tipo === 'INSUMO' ? ' active' : '' %>" href="/insumos?tipo=INSUMO<%= search ? '&q=' + encodeURIComponent(search) : '' %>">Insumos (<%= contagens.INSUMO %>)</a>
  <a class="filter-pill<%= tipo === 'EMBALAGEM' ? ' active' : '' %>" href="/insumos?tipo=EMBALAGEM<%= search ? '&q=' + encodeURIComponent(search) : '' %>">Embalagens (<%= contagens.EMBALAGEM %>)</a>
</div>

<div class="sec-title">Insumos e embalagens</div>

<% if (!insumos.length) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/></svg>
    <h3>Nenhum insumo encontrado</h3>
    <p>Importe um CSV em <a href="/fichas">Fichas</a> para cadastrar insumos automaticamente.</p>
  </div>
<% } else { %>
  <div class="list-card">
    <% insumos.forEach(function (item) { %>
      <div class="list-row">
        <div class="thumb thumb-sm<%= item.insumo.tipo === 'EMBALAGEM' ? ' emb' : '' %>">
          <% if (item.insumo.tipo === 'EMBALAGEM') { %>
            <svg viewBox="0 0 24 24"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <% } else { %>
            <svg viewBox="0 0 24 24"><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6a2 2 0 0 0 2 2h3zm0 0v7"/><path d="M3 2c0 6 4 6 4 9v9"/></svg>
          <% } %>
        </div>
        <div class="row-main">
          <div class="row-title"><%= item.insumo.nome %></div>
          <div class="row-sub">R$ <%= item.custoMedio.toFixed(2).replace('.', ',') %> médio</div>
          <div class="row-meta"><%= item.insumo.codigo %> · <%= item.qtdMedia.toFixed(1).replace('.', ',') %> <%= item.insumo.unidade %> méd.</div>
        </div>
        <span class="row-badge"><%= item.emPratos %> <%= item.emPratos === 1 ? 'prato' : 'pratos' %></span>
      </div>
    <% }) %>
  </div>
<% } %>
