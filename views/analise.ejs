<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="sec-title" style="margin-top:0">Progresso de preço</div>

<div class="filter-pills" style="margin-bottom:12px">
  <a class="filter-pill<%= tipo === 'prato' ? ' active' : '' %>" href="/analise-precos?tipo=prato">Por prato</a>
  <a class="filter-pill<%= tipo === 'insumo' ? ' active' : '' %>" href="/analise-precos?tipo=insumo">Por insumo</a>
</div>

<form method="get" action="/analise-precos" style="margin-bottom:12px">
  <input type="hidden" name="tipo" value="<%= tipo %>" />
  <input type="hidden" name="periodo" value="<%= periodo %>" />
  <div class="ep-field" style="margin-bottom:0">
    <select name="item" onchange="this.form.submit()">
      <% opcoes.forEach(function (o) { %>
        <option value="<%= o.codigo %>" <%= o.codigo === codigo ? 'selected' : '' %>><%= o.nome %></option>
      <% }) %>
    </select>
  </div>
</form>

<div class="filter-pills">
  <a class="filter-pill<%= periodo === 'dia' ? ' active' : '' %>" href="/analise-precos?tipo=<%= tipo %>&item=<%= encodeURIComponent(codigo) %>&periodo=dia">Dia</a>
  <a class="filter-pill<%= periodo === 'mes' ? ' active' : '' %>" href="/analise-precos?tipo=<%= tipo %>&item=<%= encodeURIComponent(codigo) %>&periodo=mes">Mês</a>
  <a class="filter-pill<%= periodo === 'ano' ? ' active' : '' %>" href="/analise-precos?tipo=<%= tipo %>&item=<%= encodeURIComponent(codigo) %>&periodo=ano">Ano</a>
</div>

<% if (!selecionado) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    <h3>Nenhum <%= tipo === 'insumo' ? 'insumo' : 'prato' %> cadastrado</h3>
    <p>Importe um CSV em <a href="/fichas">Fichas</a> para começar a registrar o histórico de preços.</p>
  </div>
<% } else if (!pontos.length) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    <h3>Ainda sem histórico para <%= selecionado.nome %></h3>
    <p>Uma nova versão é registrada automaticamente sempre que o custo desse <%= tipo === 'insumo' ? 'insumo' : 'prato' %> mudar (reimportação de CSV ou edição no Editor).</p>
  </div>
<% } else { %>
  <div class="chart-card wide">
    <% if (tipo === 'insumo') { %>
      <div class="chart-title"><%= selecionado.nome %> — custo unitário (R$/<%= selecionado.unidade %>)</div>
    <% } else { %>
      <div class="chart-title"><%= selecionado.nome %> — custo total e preço sugerido (R$)</div>
    <% } %>
    <div class="chart-wrap" style="height:240px"><canvas id="c-progresso"></canvas></div>
  </div>

  <div class="sec-title">Comparação de versões</div>
  <div class="list-card">
    <% pontos.slice().reverse().forEach(function (p) { %>
      <% var casas = tipo === 'insumo' ? 4 : 2; %>
      <% var subiu = p.deltaPct !== null && p.deltaPct > 0.05; %>
      <% var desceu = p.deltaPct !== null && p.deltaPct < -0.05; %>
      <div class="cmp-row">
        <div class="cmp-top">
          <div class="cmp-label"><%= p.label %></div>
          <div class="cmp-vals">
            <% if (p.deltaPct !== null) { %>
              <span class="cmp-delta <%= subiu ? 'up' : (desceu ? 'down' : 'flat') %>"><%= subiu ? '▲' : (desceu ? '▼' : '–') %> <%= Math.abs(p.deltaPct).toFixed(1).replace('.', ',') %>%</span>
            <% } %>
            <span class="cmp-value">R$ <%= p.valor.toFixed(casas).replace('.', ',') %></span>
          </div>
        </div>
        <div class="cmp-bar-track">
          <div class="cmp-bar-fill <%= subiu ? 'up' : '' %>" style="width:<%= p.barPct %>%"></div>
        </div>
        <% if (tipo === 'prato') { %>
          <div class="cmp-meta">Preço sugerido R$ <%= p.precoSugerido.toFixed(2).replace('.', ',') %><%= p.cmv !== null ? ' · CMV ' + p.cmv.toFixed(1).replace('.', ',') + '%' : '' %></div>
        <% } %>
      </div>
    <% }) %>
  </div>

  <script>
    (function () {
      var pontos = <%- JSON.stringify(pontos) %>;
      var tipo = <%- JSON.stringify(tipo) %>;
      var datasets;
      if (tipo === 'insumo') {
        datasets = [
          {
            label: 'Custo unitário',
            data: pontos.map(function (p) { return p.custoUnitario; }),
            borderColor: '#2bb24a',
            backgroundColor: 'rgba(43,178,74,.1)',
            tension: 0.3,
            pointRadius: 3,
          },
        ];
      } else {
        datasets = [
          {
            label: 'Custo total',
            data: pontos.map(function (p) { return p.custoTotal; }),
            borderColor: '#e15046',
            backgroundColor: 'rgba(225,80,70,.1)',
            tension: 0.3,
            pointRadius: 3,
          },
          {
            label: 'Preço sugerido',
            data: pontos.map(function (p) { return p.precoSugerido; }),
            borderColor: '#2bb24a',
            backgroundColor: 'rgba(43,178,74,.1)',
            tension: 0.3,
            pointRadius: 3,
          },
        ];
      }
      new Chart(document.getElementById('c-progresso'), {
        type: 'line',
        data: {
          labels: pontos.map(function (p) { return p.label; }),
          datasets: datasets,
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: true, position: 'bottom', labels: { font: { size: 11 }, color: '#60705e' } } },
          scales: {
            x: { ticks: { font: { size: 10 }, color: '#60705e' }, grid: { display: false } },
            y: { ticks: { font: { size: 10 }, color: '#60705e' }, grid: { color: '#e2ede0' } },
          },
        },
      });
    })();
  </script>
<% } %>
